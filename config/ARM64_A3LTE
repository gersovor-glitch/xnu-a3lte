#
# a3lte (SM-A300F) ARM64 kernel configuration
# Based on XNU ARM64 DEVELOPMENT config
#

include $(MAKETOP)/config/ARM64_COMMON

# Platform
MACHINE_CONFIGS=a3lte

# Kernel type
KERNEL_CONFIGS=DEVELOPMENT

# Architecture
ARCH_CONFIGS=ARM64

# Platform-specific options
OPTIONS += A3LTE=1
OPTIONS += MSM8916=1
OPTIONS += CORTEX_A53=1

# Memory
OPTIONS += PHYS_MEMORY_BASE=0x80000000
OPTIONS += PHYS_MEMORY_SIZE=0x40000000

# Console
OPTIONS += SERIAL_CONSOLE=1
OPTIONS += UART_BASE=0x78B0000
OPTIONS += UART_BAUD=115200

# Display
OPTIONS += FRAMEBUFFER=1
OPTIONS += FB_BASE=0x1A00000
OPTIONS += FB_WIDTH=540
OPTIONS += FB_HEIGHT=960
OPTIONS += FB_STRIDE=2160
OPTIONS += FB_DEPTH=32

# Timer
OPTIONS += TIMER_BASE=0xB020000
OPTIONS += TIMER_FREQ=19200000

# GIC
OPTIONS += GIC_V2=1
OPTIONS += GIC_DIST_BASE=0xB000000
OPTIONS += GIC_REDIST_BASE=0xB002000
OPTIONS += GIC_CPU_BASE=0xB001000

# CPU
OPTIONS += CPU_COUNT=4
OPTIONS += SPIN_TABLE=1
OPTIONS += SPIN_TABLE_ADDR=0x86700088

# PMIC
OPTIONS += SPMI=1
OPTIONS += SPMI_BASE=0x200F000
OPTIONS += PM8916=1
OPTIONS += RT5033=1

# Storage
OPTIONS += SDHCI=1
OPTIONS += EMMC_BASE=0x7824900
OPTIONS += SD_BASE=0x7864900

# USB
OPTIONS += USB=1
OPTIONS += USB_BASE=0x78D9000

# Page size: force 4KB (MSM8916 hardware requirement)
OPTIONS += __ARM_16K_PG__=0
OPTIONS += ARM64_4K_PAGES=1

# Debug
OPTIONS += DEBUG=1
OPTIONS += KASAN=0
OPTIONS += KASLR=0

# Panic behavior
OPTIONS += PANIC_REBOOT=1
OPTIONS += PANIC_TIMEOUT=5
