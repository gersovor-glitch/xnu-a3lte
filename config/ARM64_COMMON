#
# ARM64 common configuration for XNU
# Shared settings for all ARM64 platforms
#

# Architecture
ARCH=arm64
CPU_TYPE=ARM_CPU_TYPE_ARM64
CPU_SUBTYPE=CPU_SUBTYPE_ARM64_ALL

# Page size
PAGE_SIZE=4096

# Kernel address space
VM_MIN_KERNEL_ADDRESS=0xFFFFFFF000000000
VM_MAX_KERNEL_ADDRESS=0xFFFFFFFFFFFFFFFF
VM_MIN_ADDRESS=0x0000000100000000
VM_MAX_ADDRESS=0x0000007FFFFFFFFF

# VM settings
VM_KERNEL_PAGE_SHIFT=14
VM_KERNEL_PAGE_SIZE=16384

# Enable ARM64 specific features
OPTIONS += ARM64=1
OPTIONS += ARM64_PHYS_CPU=1
OPTIONS += ARM64_VMSA=1
OPTIONS += ARM64_EL1_UNUSED=1

# Cache
OPTIONS += ARM64_CACHEOPS=1

# GIC
OPTIONS += GIC_V3=1

# PSCI
OPTIONS += PSCI=1

# Timer
OPTIONS += ARM_GENERIC_TIMER=1
OPTIONS += ARM_TIMER=1

# Debug
OPTIONS += DEBUG=1

# KASLR
OPTIONS += KASLR=0

# PANIC
OPTIONS += PANIC_REBOOT=1
OPTIONS += PANIC_TIMEOUT=5

# Embedded
OPTIONS += EMBEDDED=1

# L2 cache
OPTIONS += L2_CACHE=1

# Vector
OPTIONS += ARM64_VECTOR=1

# FPU
OPTIONS += ARM64_FPU=1

# SVE
OPTIONS += ARM64_SVE=0

# MTE
OPTIONS += ARM64_MTE=0

# BTI
OPTIONS += ARM64_BTI=0

# PAC
OPTIONS += ARM64_PAC=0

# Spectre mitigations
OPTIONS += ARM64_SPECTRE=1

# CoreSight
OPTIONS += ARM64_CORESIGHT=0

# PMU
OPTIONS += ARM64_PMU=1

# RAS
OPTIONS += ARM64_RAS=0

# SMMU
OPTIONS += ARM64_SMMU=0

# ACPI
OPTIONS += ACPI=0

# Devicetree
OPTIONS += DEVICETREE=1

# Boot args
OPTIONS += BOOT_ARGS=1

# Console
OPTIONS += SERIAL_CONSOLE=1

# Framebuffer
OPTIONS += FRAMEBUFFER=1

# SPIN table
OPTIONS += SPIN_TABLE=1

# SMP
OPTIONS += SMP=1

# CPU topology
OPTIONS += CPU_TOPOLOGY=1